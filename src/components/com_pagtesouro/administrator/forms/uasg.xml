<?xml version="1.0" encoding="utf-8"?>
<!-- Cadastro de UASG (Unidade Administrativa de Serviços Gerais) -->
<form>
	<fieldset name="details" label="COM_PAGTESOURO_UASG_DETAILS">
		<field
			name="id"
			type="hidden"
			default="0"
			filter="integer"
		/>
		<field
			name="descricao"
			type="text"
			label="COM_PAGTESOURO_FIELD_UASG_DESCRICAO_LABEL"
			description="COM_PAGTESOURO_FIELD_UASG_DESCRICAO_DESC"
			hint="COM_PAGTESOURO_FIELD_UASG_DESCRICAO_HINT"
			required="true"
			maxlength="255"
			filter="string"
		/>
		<field
			name="orgao"
			type="text"
			label="COM_PAGTESOURO_FIELD_ORGAO_LABEL"
			description="COM_PAGTESOURO_FIELD_ORGAO_DESC"
			hint="COM_PAGTESOURO_FIELD_ORGAO_HINT"
			required="true"
			maxlength="10"
			inputmode="numeric"
			class="w-auto"
			filter="string"
		/>
		<field
			name="ug"
			type="text"
			label="COM_PAGTESOURO_FIELD_UG_LABEL"
			description="COM_PAGTESOURO_FIELD_UG_DESC"
			hint="COM_PAGTESOURO_FIELD_UG_HINT"
			required="true"
			maxlength="10"
			inputmode="numeric"
			class="w-auto"
			filter="string"
		/>
		<field
			name="state"
			type="radio"
			label="COM_PAGTESOURO_FIELD_STATE_LABEL"
			description="COM_PAGTESOURO_FIELD_UASG_STATE_DESC"
			layout="joomla.form.field.radio.switcher"
			default="1"
			filter="integer"
			>
			<option value="0">COM_PAGTESOURO_NAO</option>
			<option value="1">COM_PAGTESOURO_SIM</option>
		</field>
	</fieldset>
</form>
